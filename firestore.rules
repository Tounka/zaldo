rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return signedIn()
        && get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.admin == true;
    }

    // Super admin = custom claim del ID token. Solo lo escribe el Admin SDK
    // (scripts/asignarSuperAdmin.mjs): ningún usuario puede dárselo desde la app.
    function isSuperAdmin() {
      return signedIn() && request.auth.token.get('superadmin', false) == true;
    }

    // Campos de permisos del perfil: su dueño nunca los escribe.
    function tocaCamposDePermiso() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasAny(['admin', 'rol', 'roles', 'superadmin']);
    }

    function isAssigned(loan) {
      return signedIn() && (
        loan.creadoPor == request.auth.uid
        || loan.asignadoA == request.auth.uid
        || loan.asignadoA == request.auth.token.email
        || (loan.cobradoresAsignados is list && request.auth.uid in loan.cobradoresAsignados)
        || (loan.cobradoresAsignados is list && request.auth.token.email in loan.cobradoresAsignados)
      );
    }

    function onlyPaymentFieldsChanged() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['pagos', 'estado', 'fechaModificacion']);
    }

    // Perfiles: cualquier usuario autenticado puede leerlos para buscar
    // colaboradores; cada usuario conserva la escritura de su propio perfil.
    // Los campos de permisos (`admin`, `rol`, `superadmin`) nunca los escribe
    // su dueño: si pudiera, isAdmin() le daría acceso a todos los préstamos.
    // `admin` lo cambia un super admin (o la consola); el rol de super admin
    // no vive aquí sino en el token.
    match /usuarios/{userId} {
      allow read: if signedIn();
      allow create: if isOwner(userId)
        && !request.resource.data.keys().hasAny(['admin', 'rol', 'roles', 'superadmin']);
      allow update: if (isOwner(userId) && !tocaCamposDePermiso())
        || (isSuperAdmin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['admin']));
      allow delete: if isOwner(userId);
    }

    match /usuarios/{userId}/{documentPath=**} {
      allow read, write: if isOwner(userId);
    }

    // Préstamos y abonos.
    // Administración puede consultar/configurar todo el módulo. Un cobrador
    // únicamente puede leer sus préstamos asignados y modificar el historial
    // de pagos, nunca el monto, fechas o colaboradores.
    match /prestamos/{userId} {
      allow read: if isAdmin() || isOwner(userId);
      allow create: if isAdmin() || isOwner(userId);
    }

    match /prestamos/{userId}/{documentPath=**} {
      allow read: if isAdmin() || isOwner(userId) || isAssigned(resource.data);
      allow create: if isAdmin() || isOwner(userId);
      allow update: if isAdmin()
        || (isOwner(userId) && onlyPaymentFieldsChanged())
        || (isAssigned(resource.data) && onlyPaymentFieldsChanged());
      allow delete: if false;
    }

    // Índice de préstamos asignados a cada cobrador: asignaciones/{cobradorUid}/prestamos/{ownerUid_prestamoId}.
    // El cobrador lo lee para saber qué préstamos de otros dueños puede consultar;
    // solo el dueño del préstamo (o administración) lo escribe.
    match /asignaciones/{cobradorUid}/prestamos/{entradaId} {
      allow read: if isOwner(cobradorUid) || isAdmin();
      allow create, update: if isAdmin()
        || (signedIn() && request.resource.data.ownerUid == request.auth.uid
            && entradaId == request.auth.uid + '_' + request.resource.data.prestamoId);
      allow delete: if isAdmin()
        || (signedIn() && resource.data.ownerUid == request.auth.uid);
    }

    // Accesos a la IA (de prueba o por tiempo): los otorga solo un super admin
    // desde /superadmin. El usuario puede leer el suyo; el Worker lo lee con el
    // token del propio usuario para decidir si lo deja pasar.
    match /accesosIA/{userId} {
      allow read: if isOwner(userId) || isSuperAdmin();
      allow create, update: if isSuperAdmin()
        && request.resource.data.keys().hasOnly(['hasta', 'nota', 'correo', 'nombre', 'otorgadoPor', 'actualizado'])
        && request.resource.data.hasta is timestamp;
      allow delete: if isSuperAdmin();
    }

    // Consumo de tokens de la IA por persona y mes (consumoIA/{uid}_{AAAA-MM}).
    // Solo lo escribe el Worker con su cuenta de servicio, que no pasa por estas
    // reglas: desde la app nadie puede bajarse el contador.
    match /consumoIA/{consumoId} {
      allow read: if isSuperAdmin() || (signedIn() && resource.data.uid == request.auth.uid);
      allow write: if false;
    }

    // Módulos privados por usuario.
    match /ahorros/{userId} {
      allow read, write: if isOwner(userId);
    }
    match /ahorros/{userId}/{documentPath=**} {
      allow read, write: if isOwner(userId);
    }

    match /ingresos/{userId} {
      allow read, write: if isOwner(userId);
    }
    match /ingresos/{userId}/{documentPath=**} {
      allow read, write: if isOwner(userId);
    }
  }
}
